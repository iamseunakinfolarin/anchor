# Copy to .env and fill in. .env is gitignored — never commit real values.

# Shipped to the app bundle (EXPO_PUBLIC_ prefix). The anon key is designed to be public;
# Row Level Security restricts it to read-only access.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local tooling only — no EXPO_PUBLIC_ prefix, so these never enter the bundle.
# Postgres connection string used by `node db/apply.mjs` to run migrations and seeds.
# Supabase dashboard → Connect → Session pooler URI.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Optional, unused in Phase 1. Never ship this key.
SUPABASE_SERVICE_ROLE_KEY=
